<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Description>Shared profiling, history, comparison, and export engine for YAAP.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Yaap.BuildLogger/Yaap.BuildLogger.csproj"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="TargetFrameworks" />
  </ItemGroup>
</Project>
